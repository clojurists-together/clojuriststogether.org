#!/bin/bash

set -euo pipefail

members_file=$(mktemp ./data/members.json.XXXXXX)
trap 'rm -f "$members_file"' EXIT

curl --fail --silent --show-error https://members.clojuriststogether.org/member-list --output "$members_file"
jq --exit-status --slurp '
    length == 1 and (.[0] |
    type == "object" and
    (.members | type == "array") and
    (.member_stats | type == "object") and
    (.member_stats.company | type == "number") and
    (.member_stats.developer | type == "number"))
' "$members_file" > /dev/null
mv "$members_file" ./data/members.json

if ! git diff --quiet HEAD -- data/members.json; then
    git add -- data/members.json
    git commit --only -m "Update members" -- data/members.json
    git push
fi
